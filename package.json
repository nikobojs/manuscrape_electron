{
  "name": "manuscrape_electron",
  "productName": "ManuScrape",
  "version": "1.0.15",
  "description": "A system tray app foor capturing scrolling screenshots",
  "main": "dist/app.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "debug": "tsc && ELECTRON_ENABLE_LOGGING=true electron-forge start -i",
    "start": "tsc && DEBUG=1 electron-forge start",
    "start-win": "tsc && electron-forge start",
    "package": "tsc && electron-forge package",
    "make": "tsc && env-cmd electron-forge make --arch x64",
    "make-arm": "tsc && env-cmd electron-forge make --arch arm64",
    "pyinstall": "npm run delete-venv && cd python && . env/bin/activate && pip3 install -r requirements.txt && deactivate",
    "pyinstall-win": "cd python && env\\Scripts\\activate && pip install -r requirements.txt && deactivate",
    "delete-venv": "rm -rf python/env && (cd python && python3 -m venv env)",
    "pyfreeze": "cd python && . env/bin/activate && pyinstaller -F --distpath ./dist -n chatjoiner src/main.py && deactivate",
    "pyfreeze-win": "python\\env\\Scripts\\activate && pyinstaller -F --distpath ./python/dist -n chatjoiner python\\src\\main.py && deactivate",
    "build-tailwind": "npx tailwindcss -i tailwind.config.css -o assets/tailwind.min.css --minify"
  },
  "author": "Code Collective ApS",
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-rpm": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "7.11.2",
    "@types/p5": "1.7.7",
    "dotenv": "^17.4.2",
    "electron": "^42.0.0",
    "env-cmd": "^11.0.0",
    "tailwindcss": "3.4.15",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "cookie": "2.0.1",
    "electron-squirrel-startup": "^1.0.1",
    "jpeg-js": "^0.4.4",
    "p5": "1.11.1"
  }
}
